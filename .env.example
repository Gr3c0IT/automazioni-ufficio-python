# Connessione al database ARCA Evolution (SQL Server)
SERVER_DB=srv-db.example.local\SQLEXPRESS
DB_ARCA=ADB_ESEMPIO
# Credenziali SQL Server: lasciare vuoti DB_USER e DB_PASSWORD
# per usare l'autenticazione integrata di Windows
DB_USER=utente_sql_finto
DB_PASSWORD=password_finta

# Report prodotti per gli agenti (Gmail API)
GMAIL_SENDER=mittente@example.com
GMAIL_TOKEN_FILE=token.pickle
REPORT_OUTPUT_DIR=

# Scadenzario via email (SMTP/IMAP Outlook)
SMTP_SERVER=smtp-mail.outlook.com
SMTP_PORT=587
IMAP_SERVER=outlook.office365.com
SMTP_USER=mittente@example.com
SMTP_PASSWORD=password_finta
SCADENZARIO_DESTINATARI=collega_a@example.com,collega_b@example.com
SCADENZARIO_OUTPUT_DIR=
